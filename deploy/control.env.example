# Generate THREE distinct random values, for example: openssl rand -base64 32
AdminKey=REPLACE_WITH_RANDOM_SECRET
PunchNodeKey=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
RelayNodeKey=REPLACE_WITH_ANOTHER_RANDOM_SECRET
PublicUrl=https://vpn.example.com
ASPNETCORE_URLS=http://127.0.0.1:5080
DataDirectory=/var/lib/edge-vpn-control
Coordinator__Hosts__0=vpn.example.com
Coordinator__FirstPort=49000
Coordinator__Capacity=100
Plans__basic__RelayEnabled=false
Plans__pro__RelayEnabled=true
Plans__pro__RelayBytesPerSecond=5242880
# First start only. Use a unique password of at least 20 characters.
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=REPLACE_WITH_STRONG_RANDOM_PASSWORD
BootstrapAdmin__RecoveryCode=REPLACE_WITH_RANDOM_RECOVERY_CODE
# After first successful start remove BootstrapAdmin entries; use /ops for node enrollment.
# Do not set RelayUrls or backup Hosts before those nodes actually exist.
